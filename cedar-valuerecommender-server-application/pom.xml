<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.metadatacenter</groupId>
    <artifactId>cedar-valuerecommender-server</artifactId>
    <version>2.8.5-SNAPSHOT</version>
  </parent>

  <groupId>org.metadatacenter</groupId>
  <artifactId>cedar-valuerecommender-server-application</artifactId>
  <packaging>jar</packaging>

  <name>CEDAR ValueRecommender Server Dropwizard Application</name>

  <properties>
    <!-- Opt in to the cedar-shade execution managed in cedar-parent. -->
    <cedar.shade.phase>package</cedar.shade.phase>
    <cedar.shade.main.class>org.metadatacenter.cedar.valuerecommender.ValueRecommenderServerApplication</cedar.shade.main.class>
    <assembly.targetDir>${project.basedir}/target</assembly.targetDir>
  </properties>

  <dependencies>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-rest-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-config-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-valuerecommender-server-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-utils-dropwizard-library</artifactId>
    </dependency>

    <dependency>
      <groupId>io.dropwizard</groupId>
      <artifactId>dropwizard-core</artifactId>
    </dependency>

    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-test-support-library</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.dropwizard</groupId>
      <artifactId>dropwizard-testing</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
    </dependency>

    <dependency>
      <groupId>javax.xml.ws</groupId>
      <artifactId>jaxws-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
    </dependency>

    <!-- Swagger 1.5.x annotations used to generate the OpenAPI 2.0 spec at build time -->
    <dependency>
      <groupId>io.swagger</groupId>
      <artifactId>swagger-annotations</artifactId>
    </dependency>

  </dependencies>

  <build>

    <plugins>

      <!--
        Generates the OpenAPI/Swagger 2.0 spec from the JAX-RS resource annotations into
        src/main/resources/assets/swagger-api/ (committed; copied onto the classpath the Dropwizard
        AssetsBundle serves). Version stamped from the POM on every build. kongchen's
        "include-project-dependencies" configurator puts the project classpath on the plugin
        classloader. Use the 1.x line of this plugin only (OpenAPI/Swagger 2.0, swagger-core 1.5.x).
      -->
      <plugin>
        <groupId>com.github.kongchen</groupId>
        <artifactId>swagger-maven-plugin</artifactId>
        <version>3.1.8</version>
        <configuration>
          <!--
            swagger-core 1.5.x (via kongchen 3.1.8) only understands the javax.ws.rs annotations.
            After the jakarta migration it scans the jakarta.ws.rs resources, finds no paths, and
            would overwrite the committed spec with an empty document. Generation is disabled so the
            committed swagger.json/yaml (last generated under javax; the API paths are unchanged by
            the namespace flip) is preserved. Regenerating requires migrating to swagger-core v3
            (jakarta / OpenAPI 3), a separate follow-up.
          -->
          <skipSwaggerGeneration>true</skipSwaggerGeneration>
          <apiSources>
            <apiSource>
              <springmvc>false</springmvc>
              <locations>
                <location>org.metadatacenter.cedar.valuerecommender.resources</location>
              </locations>
              <schemes>
                <scheme>https</scheme>
              </schemes>
              <info>
                <title>CEDAR Value Recommender Server API</title>
                <description>CEDAR Value Recommender Server API</description>
                <version>${project.version}</version>
              </info>
              <securityDefinitions>
                <securityDefinition>
                  <jsonPath>${project.basedir}/src/main/swagger/security-definitions.json</jsonPath>
                </securityDefinition>
              </securityDefinitions>
              <swaggerDirectory>${project.basedir}/src/main/resources/assets/swagger-api</swaggerDirectory>
              <swaggerFileName>swagger</swaggerFileName>
              <outputFormats>json,yaml</outputFormats>
            </apiSource>
          </apiSources>
          <!-- Sort all maps by key so the committed spec is byte-stable across builds. -->
          <enabledObjectMapperFeatures>
            <feature>com.fasterxml.jackson.databind.SerializationFeature.ORDER_MAP_ENTRIES_BY_KEYS</feature>
          </enabledObjectMapperFeatures>
        </configuration>
        <dependencies>
          <!-- Override the ancient transitive javassist (3.21.0-GA) which can't parse Java 17 bytecode. -->
          <dependency>
            <groupId>org.javassist</groupId>
            <artifactId>javassist</artifactId>
            <version>3.29.2-GA</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <phase>prepare-package</phase>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>2.7</version>
        <executions>
          <execution>
            <id>copy-resources</id>
            <phase>validate</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${assembly.targetDir}/classes</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/resources</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>

  </build>

</project>
